# Read by Cloudflare (Pages and Workers static assets), and by `npm run preview` through
# vite.config.ts, which uses the "/*" blocks below. Keep every "/*" header in a "/*" block.

# Security headers. The app makes no network requests, so connect-src is 'none'.
# object-src 'none': if opening a CV PDF in a new tab is ever blocked by a browser's PDF viewer,
# change it to `object-src blob:` and nothing else.
# Pass 7 (bookmarklet): if it ever needs window.opener or postMessage back, change
# Cross-Origin-Opener-Policy to same-origin-allow-popups.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Not listed in search engines yet. Delete this block to allow indexing.
/*
  X-Robots-Tag: noindex, nofollow

# Hashed files never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself must be checked again, so a new deploy is picked up at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
